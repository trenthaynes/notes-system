# Copy this file to .env and fill in all values before deploying.
# Never commit .env to git.

# ── PiperVault ─────────────────────────────────────────────────────────────────

# The domain where PiperVault will be reachable (no https:// prefix).
# Example: vault.yourdomain.com
PIPERVAULT_DOMAIN=vault.yourdomain.com

# Strong random secret for JWT token signing.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# AskSage API token for PiperVault's RAG chat feature.
# Only used for LLM inference; embeddings remain local (ONNX).
# Select "Ask Sage" as the provider in PiperVault's LLM settings after first login.
ASK_SAGE_TOKEN=

# ── Traefik ────────────────────────────────────────────────────────────────────

# The cert resolver name configured in your Traefik static config.
# Common values: letsencrypt, le, cloudflare
TRAEFIK_CERT_RESOLVER=letsencrypt

# ── notes-mcp (added in U7) ───────────────────────────────────────────────────

# Token the MCP server uses to authenticate with PiperVault.
# Create this in PiperVault's API Keys settings after first login.
PIPERVAULT_API_TOKEN=

# Domain where the MCP server will be reachable (no https:// prefix).
NOTES_MCP_DOMAIN=mcp.yourdomain.com
